#!/usr/bin/env bash
set -euo pipefail

# Linux orbs support static checks, not MicLine's macOS 27 app/toolchain.
[[ "$(uname -s)/$(uname -m)" == Linux/x86_64 ]] || {
    echo 'MicLine orb setup requires Linux x86_64.' >&2
    exit 1
}
started=$SECONDS
echo '[setup] Checking Debian prerequisites'
missing=()
for package in ca-certificates curl git jq python3 shellcheck tar; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    sudo -n apt-get update
    sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
echo "[setup] Prerequisites ready (${SECONDS}s)"

# Match the versions in CI; verify release archives before installing executables.
# /usr/local/bin is already available to fresh non-interactive login shells.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
install_tool() {
    local name=$1 version=$2 version_flag=$3 url=$4 checksum=$5
    local installed=''
    if [[ -x "/usr/local/bin/$name" ]]; then
        installed=$("/usr/local/bin/$name" "$version_flag" | head -n 1)
    fi
    if [[ "$installed" == "$version" ]]; then
        echo "[setup] $name $version already installed"
        return
    fi
    local step=$SECONDS
    echo "[setup] Installing $name $version"
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
        --connect-timeout 15 --max-time 90 --retry 2 "$url" -o "$work/$name.tar.gz"
    printf '%s  %s\n' "$checksum" "$work/$name.tar.gz" | sha256sum --check --strict
    tar -xzf "$work/$name.tar.gz" -C "$work" "$name"
    sudo -n install -m 0755 "$work/$name" "/usr/local/bin/$name"
    [[ "$("/usr/local/bin/$name" "$version_flag" | head -n 1)" == "$version" ]]
    echo "[setup] $name ready ($((SECONDS - step))s)"
}

install_tool actionlint 1.7.7 -version \
    https://github.com/rhysd/actionlint/releases/download/v1.7.7/actionlint_1.7.7_linux_amd64.tar.gz \
    023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757
install_tool gitleaks 8.30.1 version \
    https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz \
    551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

echo "[setup] Ready for Linux static checks ($((SECONDS - started))s total)."
echo '[setup] Swift builds/tests, Sparkle fixtures, signing and UI/audio require macOS 27 + Xcode 27.'
